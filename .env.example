# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
# Runtime database connection (role: saathi_app). The roles are created by infra/postgres/init.sql.
# With the compose dev profile (README "Run it locally") Postgres is published on 127.0.0.1:15432.
DATABASE_URL=postgres://saathi_app:change-me@127.0.0.1:15432/saathi
# Schema-owner connection read only by `npm run migrate` / `dist/migrate.js` (falls back to DATABASE_URL).
DATABASE_URL_MIGRATIONS=postgres://saathi_owner:change-me@127.0.0.1:15432/saathi
# pino level: trace|debug|info|warn|error|fatal|silent. Default info; an unknown value logs one warning and uses info.
LOG_LEVEL=info
# Directory for uploaded files (mounted volume in Docker). Private files live under <MEDIA_ROOT>/private.
MEDIA_ROOT=./media
# In-process job consumer (pg-boss). Set false to run the app without processing jobs.
JOBS_ENABLED=true
JOBS_CONCURRENCY=2
# Optional override of the SQL directory for `npm run migrate` and `node dist/migrate.js`. Unset, each uses the
# migrations/ directory next to itself (src/server/db/migrations, dist/migrations); the Docker image sets /app/dist/migrations.
# MIGRATIONS_DIR=./dist/migrations

# ── Filled in later phases (kept here so nothing is a surprise) ──────────────
# APP_URL=http://localhost:8081       # Phase 1: public URL (no trailing slash) for absolute links in emails
# MEDIA_SIGNING_SECRET=...            # Phase 2: 32+ random characters (openssl rand -hex 32); signs media URLs
# SMTP_HOST=smtp.gmail.com            # Phase 1
# SMTP_PORT=587
# SMTP_USER=someone@gmail.com
# SMTP_PASS=app-password
# MAIL_FROM="Saathi Cares <someone@gmail.com>"

# ── Compose (infra/.env.compose.example; set in infra/.env.compose or /srv/saathi/.env.prod, not here) ──
# IMAGE_TAG, DATA_ROOT and the variables below are read by docker compose, not by the app.
# The app container's DATABASE_URL is assembled in infra/compose.yaml from SAATHI_APP_PASSWORD.
# ── Host-level (read by infra/checks/check.sh and the backup container, not by the app) ──
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# UPTIME_HEARTBEAT_URL=https://...   # dead-man ping target
# RESTIC_PASSWORD=...                # backup encryption passphrase (escrowed, PLAN.md D24)
# POSTGRES_PASSWORD=...              # superuser password for the postgres container
# SAATHI_OWNER_PASSWORD=...
# SAATHI_APP_PASSWORD=...
