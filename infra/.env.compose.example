# Copy to /srv/saathi/.env.prod (or .env.staging) on the VPS, or to infra/.env.compose on a laptop.
IMAGE_TAG=latest
DATA_ROOT=/srv/saathi
LOG_LEVEL=info
POSTGRES_PASSWORD=change-me
SAATHI_OWNER_PASSWORD=change-me
SAATHI_APP_PASSWORD=change-me
RESTIC_PASSWORD=replace-with-openssl-rand-base64-32
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/replace
# Phase 2: signs media URLs; not read by the app yet.
# MEDIA_SIGNING_SECRET=replace-with-openssl-rand-hex-32
# Read by infra/checks/check.sh on the VPS (not by Compose): the hosted uptime monitor's heartbeat URL.
# UPTIME_HEARTBEAT_URL=https://replace-with-the-monitor-heartbeat-url
# .env.staging only: the staging basic-auth user and password (the plain-text pair behind certs/staging.htpasswd),
# used by scripts/deploy-remote.sh for the post-deploy smoke test through the edge.
# SMOKE_BASIC_AUTH=user:password
