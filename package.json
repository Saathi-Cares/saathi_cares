{
  "name": "saathi-cares",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --port 8081",
    "build": "next build",
    "start": "next start --port 3000",
    "build:migrate": "esbuild src/server/db/migrate-cli.ts --bundle --platform=node --target=node24 --format=esm --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" --outfile=dist/migrate.js --external:pg-native",
    "migrate": "tsx src/server/db/migrate-cli.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --exclude \"**/*.int.test.ts\"",
    "test:int": "vitest run int.test",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run test:int"
  },
